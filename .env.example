# lm studio
LM_STUDIO_API_KEY=
LM_STUDIO_BASE_URL=http://localhost:1234/v1

# openai
OPENAI_API_KEY=

# gemini
GEMINI_API_KEY=

# anthropic
ANTHROPIC_API_KEY=

MOUNT_FOLDER=/mnt/

# models shown in the UI selector (comma-separated, defaults to LLM_MODEL only)
# AVAILABLE_MODELS=lmstudio:qwen/qwen3.6-27b,openai:gpt-4o,anthropic:claude-sonnet-4-6
